# AC100 extras: merge after paz00_defconfig with
#   scripts/kconfig/merge_config.sh -m .config board/compal/paz00/ac100.config && make olddefconfig
CONFIG_CMD_SETEXPR=y
CONFIG_CMD_ENTERRCM=y
CONFIG_CMD_BOOTMENU=y
CONFIG_CMD_CAT=y
CONFIG_CMD_XXD=y
CONFIG_CMD_PART=y
CONFIG_CMD_GPT=y
CONFIG_CMD_MMC_SWRITE=n
CONFIG_SYS_PROMPT="paz00 # "
CONFIG_KEYBOARD_NVEC=y
CONFIG_CMD_NVECDBG=y
CONFIG_VIDEO_DAMAGE=y
# CONFIG_SYS_USB_EVENT_POLL is not set
CONFIG_SYS_USB_EVENT_POLL_VIA_INT_QUEUE=y
CONFIG_BOOTDELAY=1
# kernel A/B fallback: bootcount kept in the env; after 1 failed boot run altbootcmd
CONFIG_BOOTCOUNT_LIMIT=y
CONFIG_BOOTCOUNT_ENV=y
CONFIG_BOOTCOUNT_BOOTLIMIT=1
CONFIG_BOOTCOUNT_ALTBOOTCMD="sysboot mmc 0:1 any ${scriptaddr} /boot/extlinux/fallback.conf"
CONFIG_CMD_SYSBOOT=y
